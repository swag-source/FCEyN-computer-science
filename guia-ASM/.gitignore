# ---------------------------------------------------------------------------
# Este archivo sobrevive a la consolidacion en el .gitignore de la raiz
# porque hace algo que la raiz no hace: una whitelist por directorio.
#
# Para src/1 a src/4 ignora TODO el contenido y despues re-permite solo las
# extensiones de codigo. Es mas estricto que una blacklist de artefactos:
# cualquier archivo nuevo que no sea .asm/.c/.h/.md/.sh/.mac/Makefile queda
# afuera por defecto, sin necesidad de agregarle un patron.
#
# Lo que SI esta en la raiz y por eso ya no esta aca: *.o, binarios de test,
# .gdb_history, venv/, __pycache__, asm_defs.txt / global_foos.txt, .DS_Store.
# ---------------------------------------------------------------------------

!src/1\ -\ Introducción
src/1\ -\ Introducción/*
!src/1\ -\ Introducción/*.asm
!src/1\ -\ Introducción/*.md
!src/1\ -\ Introducción/Makefile

!src/2\ -\ ABI/
src/2\ -\ ABI/*
!src/2\ -\ ABI/*.asm
!src/2\ -\ ABI/*.c
!src/2\ -\ ABI/*.h
!src/2\ -\ ABI/*.md
!src/2\ -\ ABI/Makefile
!src/2\ -\ ABI/*.sh
!src/2\ -\ ABI/*.mac

!src/3\ -\ Alineación\ y\ Estructuras
src/3\ -\ Alineación\ y\ Estructuras/*
!src/3\ -\ Alineación\ y\ Estructuras/*.asm
!src/3\ -\ Alineación\ y\ Estructuras/*.c
!src/3\ -\ Alineación\ y\ Estructuras/*.h
!src/3\ -\ Alineación\ y\ Estructuras/*.md
!src/3\ -\ Alineación\ y\ Estructuras/Makefile
!src/3\ -\ Alineación\ y\ Estructuras/*.sh
!src/3\ -\ Alineación\ y\ Estructuras/*.mac

!src/4\ -\ Memoria\ dinámica
src/4\ -\ Memoria\ dinámica/*
!src/4\ -\ Memoria\ dinámica/*.asm
!src/4\ -\ Memoria\ dinámica/*.c
!src/4\ -\ Memoria\ dinámica/*.h
!src/4\ -\ Memoria\ dinámica/*.md
!src/4\ -\ Memoria\ dinámica/Makefile
!src/4\ -\ Memoria\ dinámica/*.sh
!src/4\ -\ Memoria\ dinámica/*.mac

# src/5, src/6 y src/7 no usan whitelist: los cubre el .gitignore de la raiz.
!src/5\ -\ Pila
!src/6\ -\ Ejercicios\ tipo\ parcial
